<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:AscendedTweaks.App.Controls">
    <!-- Komponenten und Zustaende nach docs/DESIGN.md, Abschnitte 3 bis 6. Farben nur ueber Tokens (DynamicResource). -->

    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>

    <!-- Fokusrahmen: 2 Punkte Akzent, 2 Punkte Abstand, bei Tastaturbedienung immer sichtbar. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" RadiusX="10" RadiusY="10" StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schrift -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Karte: Radius 12, Innenabstand 16, Mindesthoehe 96. -->
    <!-- V2 Einfach-Modus: Fliesstext 15 statt 14, Titel 17, Hinweise 13. -->
    <Style x:Key="Text.Simple.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Simple.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Simple.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Hinweisleiste oben (Ehrlichkeit, Versionsstatus) -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Schaltflaechen: Primaer, Sekundaer, Text, Gefahr; Zustaende Normal, Hover, Gedrueckt, Fokus, Deaktiviert, Laufend. -->
    <Style x:Key="Button.Base" TargetType="c:ActionButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ActionButton">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="{StaticResource Radius.Small}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Overlay" CornerRadius="{StaticResource Radius.Small}" Background="{TemplateBinding Foreground}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <ui:ProgressRing x:Name="Spinner" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed"
                                             Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsRunning" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter Property="Cursor" Value="Wait" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Primary" TargetType="c:ActionButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Button.Secondary" TargetType="c:ActionButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Button.Text" TargetType="c:ActionButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="Button.Danger" TargetType="c:ActionButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <!-- Schalter 40 x 20: aus, an, Teilweise (IsChecked = null), Hover, Fokus, deaktiviert, nicht verfuegbar (deaktiviert mit Tooltip). -->
    <Style x:Key="Toggle.Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="Transparent" BorderBrush="{DynamicResource Brush.TextSecondary}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Brush.TextSecondary}" />
                            <Rectangle x:Name="Dash" Width="12" Height="2" RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                       Fill="{DynamicResource Brush.OnAccent}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badge: Radius 8, Text plus Symbol. -->
    <Style TargetType="c:Badge">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Badge">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="{StaticResource Radius.Small}" Background="{TemplateBinding BorderBrush}" Opacity="0" />
                        <Border CornerRadius="{StaticResource Radius.Small}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="Icon" Symbol="{TemplateBinding Symbol}" FontSize="12" Foreground="{TemplateBinding BorderBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontFamily="{StaticResource Font.Text}" FontSize="12"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="Filled" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.15" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation: Eintrag mit Symbol und Text; ausgewaehlt mit Akzentstrich links. -->
    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Small}" Background="Transparent" />
                        <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                   Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        <ContentPresenter Margin="12,8" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Getoente Flaeche statt "Erhoeht": im hellen Theme sind Flaeche und Erhoeht beide weiss. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="0.10" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="0.14" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alle Listen: Auswahl wie in der Navigation (Flaeche Erhoeht plus Akzentstrich), damit Text lesbar bleibt. -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Nav.Item}" />

    <!-- Bereichsauswahl innerhalb einer Seite (Segmente). Auswahl: getoente Flaeche plus Akzentstrich unten. -->
    <Style x:Key="Segment.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid MinHeight="36">
                        <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Small}" Background="Transparent" />
                        <Border CornerRadius="{StaticResource Radius.Small}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                        <Rectangle x:Name="Indicator" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="12,0" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        <ContentPresenter Margin="16,8" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="0.10" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="0.14" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Segment.Item}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
