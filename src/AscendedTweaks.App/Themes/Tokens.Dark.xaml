<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens of the only design: plum night with victory gold. Values live only here, never in page XAML. -->
    <Color x:Key="Color.Background">#18131F</Color>
    <Color x:Key="Color.Surface">#221B2B</Color>
    <Color x:Key="Color.Elevated">#2C2437</Color>
    <Color x:Key="Color.Border">#40364F</Color>
    <Color x:Key="Color.Accent">#FFD23F</Color>
    <Color x:Key="Color.OnAccent">#18131F</Color>
    <Color x:Key="Color.Success">#5EE0A0</Color>
    <Color x:Key="Color.Warning">#FF9F43</Color>
    <Color x:Key="Color.Danger">#FF6B8A</Color>
    <Color x:Key="Color.TextPrimary">#F7F2FC</Color>
    <Color x:Key="Color.TextSecondary">#BBB0CC</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{StaticResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <!-- Selection and icon tiles: 14 % accent (checked by tools/contrast-check as "Auswahl"). -->
    <SolidColorBrush x:Key="Brush.AccentTint" Color="{StaticResource Color.Accent}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <!-- Abdunklung hinter Dialogen (60 Prozent Schwarz). -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#000000" Opacity="0.6" />

    <!-- Preset colors: one cheerful hue per preset, for its top edge, its symbol and its 16 % tile (symbol on tile at least 5.4:1). -->
    <Color x:Key="Hue.Mint">#5EE0A0</Color>
    <Color x:Key="Hue.Sky">#63C2FF</Color>
    <Color x:Key="Hue.Coral">#FF8A65</Color>
    <Color x:Key="Hue.Lime">#B5E655</Color>
    <Color x:Key="Hue.Lilac">#C3A6FF</Color>
    <Color x:Key="Hue.Rose">#FF8CC6</Color>
    <Color x:Key="Hue.Teal">#3FD9CF</Color>
    <SolidColorBrush x:Key="Brush.Hue.Mint" Color="{StaticResource Hue.Mint}" />
    <SolidColorBrush x:Key="Brush.Hue.Sky" Color="{StaticResource Hue.Sky}" />
    <SolidColorBrush x:Key="Brush.Hue.Coral" Color="{StaticResource Hue.Coral}" />
    <SolidColorBrush x:Key="Brush.Hue.Lime" Color="{StaticResource Hue.Lime}" />
    <SolidColorBrush x:Key="Brush.Hue.Lilac" Color="{StaticResource Hue.Lilac}" />
    <SolidColorBrush x:Key="Brush.Hue.Rose" Color="{StaticResource Hue.Rose}" />
    <SolidColorBrush x:Key="Brush.Hue.Teal" Color="{StaticResource Hue.Teal}" />
    <SolidColorBrush x:Key="Brush.Hue.Mint.Tint" Color="{StaticResource Hue.Mint}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Sky.Tint" Color="{StaticResource Hue.Sky}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Coral.Tint" Color="{StaticResource Hue.Coral}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Lime.Tint" Color="{StaticResource Hue.Lime}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Lilac.Tint" Color="{StaticResource Hue.Lilac}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Rose.Tint" Color="{StaticResource Hue.Rose}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Teal.Tint" Color="{StaticResource Hue.Teal}" Opacity="0.16" />

    <!-- Glow: soft gold light on the main action and the selected navigation bar only. -->
    <DropShadowEffect x:Key="Glow.Accent" Color="{StaticResource Color.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />

    <!-- Ueberschreibt die Grundfarben von WPF-UI, damit Standard-Steuerelemente zu den Tokens passen. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
</ResourceDictionary>
