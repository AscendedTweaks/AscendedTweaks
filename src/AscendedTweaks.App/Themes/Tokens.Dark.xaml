<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens of the only design: gray as the main color (like a chat app), black for edges and shading, white text,
         blue accents (strong blue buttons, light blue links and toggles, navy selection). Values live only here. -->
    <Color x:Key="Color.Background">#2B2D31</Color>
    <Color x:Key="Color.Surface">#313338</Color>
    <Color x:Key="Color.Elevated">#383A40</Color>
    <Color x:Key="Color.Border">#1E1F22</Color>
    <Color x:Key="Color.Accent">#8AB0FF</Color>
    <Color x:Key="Color.OnAccent">#1E1F22</Color>
    <Color x:Key="Color.Success">#BEBEBE</Color>
    <Color x:Key="Color.Warning">#F2F2F2</Color>
    <Color x:Key="Color.Danger">#F29A9A</Color>
    <Color x:Key="Color.TextPrimary">#F2F2F2</Color>
    <Color x:Key="Color.TextSecondary">#BEBEBE</Color>
    <!-- Buttons: strong blue with white text. Links, focus and toggles use the lighter Color.Accent. -->
    <Color x:Key="Color.AccentFill">#3D6BE0</Color>
    <Color x:Key="Color.OnAccentFill">#FFFFFF</Color>
    <!-- Selected navigation entry, segment and symbol tiles: navy. -->
    <Color x:Key="Color.AccentTint">#2A3A5E</Color>
    <!-- Frame: title bar and navigation, a step darker than the content panel so the two sides read apart. -->
    <Color x:Key="Color.Sidebar">#202124</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{StaticResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentTint" Color="{StaticResource Color.AccentTint}" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="{StaticResource Color.AccentFill}" />
    <SolidColorBrush x:Key="Brush.OnAccentFill" Color="{StaticResource Color.OnAccentFill}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <!-- Abdunklung hinter Dialogen (60 Prozent Schwarz). -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#000000" Opacity="0.6" />

    <!-- Glow: soft blue light around primary buttons, the selected navigation bar and preset symbols. Never on text. -->
    <DropShadowEffect x:Key="Glow.Accent" Color="{StaticResource Color.AccentFill}" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Soft" Color="{StaticResource Color.Accent}" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
    <!-- Shading: a soft black shadow under the hero and the preset tiles (drawn on an underlay, so text stays crisp). -->
    <DropShadowEffect x:Key="Shadow.Card" Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" />

    <!-- Ueberschreibt die Grundfarben von WPF-UI, damit Standard-Steuerelemente zu den Tokens passen. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
</ResourceDictionary>
