<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens of the only design (dark): clean neutral dark with a coral accent. Values live only here, never in page XAML. -->
    <Color x:Key="Color.Background">#141414</Color>
    <Color x:Key="Color.Surface">#1E1E1F</Color>
    <Color x:Key="Color.Elevated">#28282A</Color>
    <Color x:Key="Color.Border">#3A3A3D</Color>
    <Color x:Key="Color.Accent">#FF7A50</Color>
    <Color x:Key="Color.OnAccent">#141414</Color>
    <Color x:Key="Color.Success">#5BD47E</Color>
    <Color x:Key="Color.Warning">#FFC93C</Color>
    <Color x:Key="Color.Danger">#FF5F73</Color>
    <Color x:Key="Color.TextPrimary">#F6F5F3</Color>
    <Color x:Key="Color.TextSecondary">#B4B2AE</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{StaticResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <!-- Selection and icon tiles: 14 % accent (checked by tools/contrast-check as "Auswahl"). -->
    <SolidColorBrush x:Key="Brush.AccentTint" Color="{StaticResource Color.Accent}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <!-- Abdunklung hinter Dialogen (60 Prozent Schwarz). -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#000000" Opacity="0.6" />

    <!-- Preset colors: one cheerful hue per preset, only for its symbol and its 16 % tile (symbol on tile at least 5:1). -->
    <Color x:Key="Hue.Mint">#4FD6A4</Color>
    <Color x:Key="Hue.Sky">#5DB9FF</Color>
    <Color x:Key="Hue.Coral">#FF7A50</Color>
    <Color x:Key="Hue.Sun">#FFC93C</Color>
    <Color x:Key="Hue.Lilac">#B9A0FF</Color>
    <Color x:Key="Hue.Rose">#FF7EB8</Color>
    <Color x:Key="Hue.Teal">#35D0C6</Color>
    <SolidColorBrush x:Key="Brush.Hue.Mint" Color="{StaticResource Hue.Mint}" />
    <SolidColorBrush x:Key="Brush.Hue.Sky" Color="{StaticResource Hue.Sky}" />
    <SolidColorBrush x:Key="Brush.Hue.Coral" Color="{StaticResource Hue.Coral}" />
    <SolidColorBrush x:Key="Brush.Hue.Sun" Color="{StaticResource Hue.Sun}" />
    <SolidColorBrush x:Key="Brush.Hue.Lilac" Color="{StaticResource Hue.Lilac}" />
    <SolidColorBrush x:Key="Brush.Hue.Rose" Color="{StaticResource Hue.Rose}" />
    <SolidColorBrush x:Key="Brush.Hue.Teal" Color="{StaticResource Hue.Teal}" />
    <SolidColorBrush x:Key="Brush.Hue.Mint.Tint" Color="{StaticResource Hue.Mint}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Sky.Tint" Color="{StaticResource Hue.Sky}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Coral.Tint" Color="{StaticResource Hue.Coral}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Sun.Tint" Color="{StaticResource Hue.Sun}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Lilac.Tint" Color="{StaticResource Hue.Lilac}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Rose.Tint" Color="{StaticResource Hue.Rose}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Hue.Teal.Tint" Color="{StaticResource Hue.Teal}" Opacity="0.16" />

    <!-- Glow: soft light around the main action, the selected navigation bar and preset symbols. Never on text or cards. -->
    <DropShadowEffect x:Key="Glow.Accent" Color="{StaticResource Color.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="Glow.Hue.Mint" Color="{StaticResource Hue.Mint}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Sky" Color="{StaticResource Hue.Sky}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Coral" Color="{StaticResource Hue.Coral}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Sun" Color="{StaticResource Hue.Sun}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Lilac" Color="{StaticResource Hue.Lilac}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Rose" Color="{StaticResource Hue.Rose}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="Glow.Hue.Teal" Color="{StaticResource Hue.Teal}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />

    <!-- Ueberschreibt die Grundfarben von WPF-UI, damit Standard-Steuerelemente zu den Tokens passen. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
</ResourceDictionary>
