<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design-Tokens Hell (docs/DESIGN.md, Abschnitt 2; Akzent, Erfolg, Warnung fuer 4,5:1 angepasst). -->
    <Color x:Key="Color.Background">#F5F7FA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Elevated">#FFFFFF</Color>
    <Color x:Key="Color.Border">#D5DBE5</Color>
    <Color x:Key="Color.Accent">#2E6DDD</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Success">#188155</Color>
    <Color x:Key="Color.Warning">#A06400</Color>
    <Color x:Key="Color.Danger">#D12F49</Color>
    <Color x:Key="Color.TextPrimary">#121722</Color>
    <Color x:Key="Color.TextSecondary">#4A5567</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{StaticResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <!-- Selection and icon tiles: 14 % accent (checked by tools/contrast-check as "Auswahl"). -->
    <SolidColorBrush x:Key="Brush.AccentTint" Color="{StaticResource Color.Accent}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <!-- Abdunklung hinter Dialogen (60 Prozent Schwarz). -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#000000" Opacity="0.6" />

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
</ResourceDictionary>
