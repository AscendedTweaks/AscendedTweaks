<UserControl x:Class="AscendedTweaks.App.Views.FirstStepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AscendedTweaks.App.Controls"
             xmlns:s="clr-namespace:AscendedTweaks.App.Services"
             xmlns:v="clr-namespace:AscendedTweaks.App.Views"
             xmlns:loc="clr-namespace:AscendedTweaks.Localization;assembly=AscendedTweaks.Localization">
    <!-- First steps (V3): 1 Welcome and language, 2 Safety and limits with required check, 3 Back up your current state. -->
    <UserControl.Resources>
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Dialog}" Width="640" AutomationProperties.Name="{s:Loc firststeps.title}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StepText}" />
                <TextBlock Style="{StaticResource Text.Title}" Text="{s:Loc firststeps.title}" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                <c:ActionButton DockPanel.Dock="Left" Style="{StaticResource Button.Text}" Content="{s:Loc firststeps.back}" Command="{Binding BackCommand}" />
                <c:ActionButton DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding NextCommand}" IsEnabled="{Binding CanContinue}" IsDefault="True">
                    <c:ActionButton.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{s:Loc firststeps.next}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                            <Setter Property="Text" Value="{s:Loc firststeps.finish}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </c:ActionButton.Content>
                </c:ActionButton>
                <Border />
            </DockPanel>

            <Grid>
                <!-- Schritt 1 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Language first, before the welcome text: two large buttons, each in its own language. -->
                    <ItemsControl ItemsSource="{Binding Languages}" Focusable="False" Margin="0,0,0,16" AutomationProperties.Name="{s:Loc firststeps.language}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:ActionButton Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Culture}"
                                                MinHeight="56" Margin="0,0,8,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Label}">
                                    <c:ActionButton.Style>
                                        <Style TargetType="c:ActionButton" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:ActionButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </c:ActionButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc firststeps.welcome}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource Banner}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info16" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc banner.honesty}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Schritt 2 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc firststeps.disclaimer}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding LimitKeys}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ui:SymbolIcon Symbol="Info16" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource Text.Body}" MaxWidth="560">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}">
                                                <Binding />
                                                <Binding Source="{x:Static loc:Localizer.Current}" Path="Culture" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="{s:Loc firststeps.understood}" IsChecked="{Binding Understood}" />
                </StackPanel>

                <!-- Schritt 3 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc firststeps.baseline}" Margin="0,0,0,12" />
                    <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc firststeps.baseline.button}" HorizontalAlignment="Left"
                                    Command="{Binding CaptureBaselineCommand}" IsRunning="{Binding IsWorking}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding BaselineStatus}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc firststeps.restorepoint}" Margin="0,0,0,12" />
                    <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc firststeps.restorepoint.button}" HorizontalAlignment="Left"
                                    Command="{Binding CreateRestorePointCommand}" IsRunning="{Binding IsWorking}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding RestorePointStatus}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{s:Loc firststeps.settingslater}" TextWrapping="Wrap" />
                </StackPanel>

            </Grid>
        </DockPanel>
    </Border>
</UserControl>
