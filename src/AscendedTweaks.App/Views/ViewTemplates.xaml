<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:AscendedTweaks.App.Controls"
                    xmlns:vm="clr-namespace:AscendedTweaks.App.ViewModels"
                    xmlns:sv="clr-namespace:AscendedTweaks.App.Services"
                    xmlns:v="clr-namespace:AscendedTweaks.App.Views"
                    xmlns:s="clr-namespace:AscendedTweaks.App.Services"
                    xmlns:loc="clr-namespace:AscendedTweaks.Localization;assembly=AscendedTweaks.Localization">
    <!-- Zuordnung ViewModel zu View ohne Reflection-Scanning (docs/DESIGN.md, Abschnitt 4). -->

    <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
        <Border Style="{StaticResource Card}">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{s:Loc page.placeholder}" />
        </Border>
    </DataTemplate>

    <!-- V2 Einfach-Modus (Abschnitt 2): eine Karte = ein Schalter, Nutzen-Titel, ein Satz, Wirkungswort, ein Risiko-Symbol. -->
    <DataTemplate x:Key="SimpleCard" DataType="{x:Type sv:TweakCardViewModel}">
        <Border Style="{StaticResource Card}" Padding="20,16">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsToggleEnabled}"
                              ToolTip="{Binding ToggleToolTip}" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Top" Margin="24,4,0,0"
                              AutomationProperties.Name="{Binding PlainTitle}" AutomationProperties.HelpText="{Binding PlainDescription}" />
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding PlainTitle}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{Binding PlainDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding TagTexts}" Focusable="False" AutomationProperties.Name="{s:Loc card.tags}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChip}">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:SymbolIcon Symbol="{Binding RiskPlainSymbol}" FontSize="16" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding RiskPlainText}" Margin="8,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding ImpactText}" VerticalAlignment="Center" ToolTip="{Binding ImpactNote}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding ToggleToolTip}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ToggleToolTip, Converter={StaticResource NullToCollapsed}}" />
                    <Expander Margin="0,8,0,0" AutomationProperties.Name="{s:Loc simple.technical}" sv:A11y.NameParts="True">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.technical}" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SideEffects}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ImpactNote}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <c:ActionButton Style="{StaticResource Button.Text}" Content="{s:Loc card.details}" Command="{Binding ShowDetailsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" MinHeight="40" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HelpViewModel}">
        <StackPanel>
            <c:ActionButton Style="{StaticResource Button.Text}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" MinHeight="40" AutomationProperties.Name="{s:Loc simple.help}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="{s:Loc simple.help}" VerticalAlignment="Center" />
                </StackPanel>
            </c:ActionButton>
            <Border Style="{StaticResource Banner}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Simple.Body}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocKey}">
                            <Binding Path="TextKey" />
                            <Binding Source="{x:Static loc:Localizer.Current}" Path="Culture" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SimpleTweakPageViewModel}">
        <StackPanel Margin="0,0,0,24">
            <ContentControl Content="{Binding Help}" Focusable="False" Margin="0,0,0,8" />
            <ui:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{s:Loc simple.search}" Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.Name="{s:Loc simple.search}" MinHeight="40" FontSize="15" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource SimpleCard}" Focusable="False" />
            <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc simple.empty}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16" />
            <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{Binding MoreText}" Command="{Binding MoreCommand}" HorizontalAlignment="Left" MinHeight="40"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding Extras}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SimpleAutostartCard}">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.autostart.title}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc simple.autostart.intro}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ContentControl Content="{Binding Autostart}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SimplePingCard}">
        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel DataContext="{Binding Tools}">
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.ping.title}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc simple.ping.intro}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="140" MinHeight="40" AutomationProperties.Name="{s:Loc simple.ping.title}" Margin="0,0,8,0" />
                    <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc net.ping.run}" Command="{Binding PingCommand}" IsRunning="{Binding IsPinging}" MinHeight="40" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Simple.Body}" TextWrapping="Wrap"><Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Summary, Mode=OneWay}" /></TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SimpleUpdatesCard}">
        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <DockPanel DataContext="{Binding Updates}">
                <c:ActionButton DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{s:Loc updates.open}" Command="{Binding OpenWindowsUpdateCommand}" VerticalAlignment="Top" MinHeight="40" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.updates.title}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{Binding PauseText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.updates.intro}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Preset tiles: navy symbol tile with a light blue symbol that glows softly. -->
    <Style x:Key="PresetTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentTint}" />
    </Style>
    <Style x:Key="PresetSymbol" TargetType="ui:SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Effect" Value="{DynamicResource Glow.Soft}" />
    </Style>

    <!-- Start page, most important first: welcome with the main action, the presets, then facts about the PC. One accent fill: the hero action. -->
    <DataTemplate DataType="{x:Type vm:SimpleStartViewModel}">
        <StackPanel Margin="0,0,0,24">
            <Grid Margin="0,0,0,24">
            <Border CornerRadius="{StaticResource Radius.Large}" Background="{DynamicResource Brush.Surface}" Effect="{DynamicResource Shadow.Card}" />
            <Border Style="{StaticResource Card}" Padding="32,24" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{s:Loc simple.start.hello}" />
                    <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc simple.start.hero}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc simple.start.recommended}" Command="{Binding Recommended.ApplyCommand}"
                                        MinHeight="40" Padding="24,8" Margin="0,0,8,0"
                                        Visibility="{Binding Recommended, Converter={StaticResource NullToCollapsed}}" AutomationProperties.HelpText="{Binding Recommended.Name}" />
                        <ContentControl Content="{Binding Help}" Focusable="False" VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding Recommended.ChangesText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Recommended.ChangesText, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>
            </Grid>

            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.start.presets}" Margin="0,0,0,12" />
            <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,16,16">
                        <Border CornerRadius="{StaticResource Radius.Large}" Background="{DynamicResource Brush.Surface}" Effect="{DynamicResource Shadow.Card}" />
                        <Border Style="{StaticResource Card}" Padding="24" Margin="0" MinHeight="200">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                    <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                                                    MinHeight="40" Margin="0,0,8,0" AutomationProperties.HelpText="{Binding ChangesText}" />
                                    <c:ActionButton Style="{StaticResource Button.Text}" Content="{s:Loc simple.preset.preview}" Command="{Binding PreviewCommand}" MinHeight="40" Margin="0,0,8,0"
                                                    Visibility="{Binding CanPreview, Converter={StaticResource BoolToVisibility}}" AutomationProperties.HelpText="{Binding Name}" />
                                    <c:ActionButton Style="{StaticResource Button.Text}" Content="{s:Loc simple.preset.undo}" Command="{Binding UndoCommand}" MinHeight="40"
                                                    Visibility="{Binding IsOwned, Converter={StaticResource BoolToVisibility}}" AutomationProperties.HelpText="{Binding Name}" />
                                </WrapPanel>
                                <ListBox DockPanel.Dock="Bottom" Style="{StaticResource Segment.List}" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                                         AutomationProperties.Name="{s:Loc level.title}" Margin="0,12,0,0" Visibility="{Binding HasLevels, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="{StaticResource Radius.Large}" Style="{StaticResource PresetTile}"
                                            VerticalAlignment="Top" Margin="0,0,16,0">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="24" Style="{StaticResource PresetSymbol}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding ChangesText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding ChangesText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:ActionButton Style="{StaticResource Button.Text}" Command="{Binding CreateOwnCommand}" HorizontalAlignment="Left" MinHeight="40" AutomationProperties.Name="{s:Loc simple.preset.own}"
                            Visibility="{Binding CanCreateOwn, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add16" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="{s:Loc simple.preset.own}" VerticalAlignment="Center" />
                </StackPanel>
            </c:ActionButton>
            <!-- Facts about the PC: information, not actions, so they come after the presets. -->
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.start.yourpc}" Margin="0,8,0,12" />
            <UniformGrid Columns="3" Margin="0,0,-12,16" AutomationProperties.Name="{Binding Status}">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.start.stat.windows}" />
                        <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding WindowsText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.start.stat.ram}" />
                        <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding RamText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Small}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.start.stat.autostart}" />
                        <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding AutostartText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{s:Loc simple.start.stat.autostart.hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <c:ActionButton Style="{StaticResource Button.Text}" Content="{s:Loc simple.start.stat.autostart.show}" Command="{Binding ShowAutostartCommand}"
                                        HorizontalAlignment="Left" Margin="-8,4,0,0" Padding="8,4" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <ContentControl Content="{Binding Measurement}" Focusable="False" Visibility="{Binding Measurement, Converter={StaticResource NullToCollapsed}}" />
            <Border Style="{StaticResource Banner}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info16" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc banner.honesty}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CustomPresetDialogViewModel}">
        <Border Style="{StaticResource Dialog}" AutomationProperties.Name="{s:Loc simple.preset.own}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.preset.own}" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{s:Loc profiles.name}" MinHeight="40" Margin="0,0,0,12" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc dialog.cancel}" Command="{Binding DeclineCommand}" IsCancel="True" Margin="0,0,8,0" MinHeight="40" />
                    <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc dialog.save}" Command="{Binding SaveCommand}" MinHeight="40" />
                </StackPanel>
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Simple.Title}" FontSize="15" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SimpleBackViewModel}">
        <StackPanel Margin="0,0,0,24">
            <ContentControl Content="{Binding Help}" Focusable="False" Margin="0,0,0,8" />
            <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc restore.undoall}" Command="{Binding UndoAllCommand}" HorizontalAlignment="Left"
                            MinHeight="44" Padding="20,8" Margin="0,0,0,16" IsEnabled="{Binding HasItems}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc simple.back.list}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Text.Simple.Body}" Text="{s:Loc simple.back.empty}" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20,12">
                            <DockPanel>
                                <c:ActionButton DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{s:Loc simple.back.undo}" MinHeight="40" VerticalAlignment="Center"
                                                Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.HelpText="{Binding Title}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Simple.Title}" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Text.Simple.Caption}" Text="{Binding When}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Dashboard (Abschnitt 6.1): nur Anzeige und eine Aktion, kein Gesamtwert. -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc dashboard.indicators}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{s:Loc dashboard.indicators.intro}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Indicators}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding Value}" TextWrapping="Wrap" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding Explanation}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc dashboard.system}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding System}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel>
            <v:SettingsPage />
            <ContentControl Content="{Binding Maintenance}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Wartung in den Einstellungen (Abschnitt 6.11). -->
    <DataTemplate DataType="{x:Type vm:SettingsMaintenanceViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc settings.update.install}" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc settings.update.check}" Command="{Binding CheckUpdateCommand}" IsRunning="{Binding IsChecking}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{s:Loc settings.update}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{s:Loc settings.update.help}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding UpdateText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc settings.logs.open}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                        <c:ActionButton Style="{StaticResource Button.Danger}" Content="{s:Loc settings.logs.delete}" Command="{Binding DeleteLogsCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{s:Loc settings.logs}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{s:Loc settings.logs.help}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LogText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{s:Loc settings.cli}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding CliText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <c:ActionButton DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{s:Loc settings.reset}" Command="{Binding ResetSettingsCommand}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{s:Loc settings.reset}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{s:Loc settings.reset.help}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
