                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{s:Loc dryrun.backup}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{s:Loc dryrun.norestorepoint}" Margin="0,4,0,0"
                                   Visibility="{Binding UserOnly, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sv:ExpertWarningViewModel}">
        <Border Style="{StaticResource Dialog}" BorderBrush="{DynamicResource Brush.Danger}" AutomationProperties.Name="{s:Loc expert.title}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <c:Badge Tone="Danger" Filled="True" Symbol="ErrorCircle16" Text="{s:Loc risk.expert}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc expert.title}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tweaks}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc expert.stage1}" Margin="0,0,0,16" />
                <CheckBox Content="{s:Loc expert.stage2}" IsChecked="{Binding Understood}" Margin="0,0,0,16">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Stage}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <StackPanel Margin="0,0,0,16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="Stage3Label" Style="{StaticResource Text.Body}" Text="{s:Loc expert.stage3}" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=Stage3Label}" AutomationProperties.Name="{s:Loc expert.stage3}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc dialog.cancel}" Command="{Binding DeclineCommand}" IsCancel="True" Margin="0,0,8,0" />
                    <c:ActionButton Style="{StaticResource Button.Danger}" Content="{s:Loc dialog.continue}" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sv:ProgressDialogViewModel}">
        <Border Style="{StaticResource Dialog}" AutomationProperties.Name="{s:Loc progress.title}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc progress.title}" Margin="0,0,0,16" />
                <ProgressBar Height="4" Minimum="0" Maximum="{Binding Total}" Value="{Binding Current}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CurrentTweak}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
                <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc progress.cancel}" HorizontalAlignment="Right"
                                Command="{Binding RequestCancelCommand}" IsRunning="{Binding IsCancelling}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sv:ResultDialogViewModel}">
        <Border Style="{StaticResource Dialog}" AutomationProperties.Name="{Binding Title}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <c:Badge Tone="Warning" Filled="True" Symbol="ArrowClockwise16" Text="{s:Loc result.reboot}" HorizontalAlignment="Left" Margin="0,0,0,16"
                             Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}" />
                    <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc dialog.close}" HorizontalAlignment="Right" Command="{Binding DoneCommand}" IsDefault="True"
                                    Visibility="{Binding HasUndo, Converter={StaticResource InverseBoolToVisibility}}" />
                    <!-- V2: Nach einem Preset gross "Alles wieder rueckgaengig", klein "Fertig". -->
                    <DockPanel Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
                        <c:ActionButton DockPanel.Dock="Right" Style="{StaticResource Button.Text}" Content="{s:Loc result.done}" Command="{Binding DoneCommand}" IsDefault="True" MinHeight="40" />
                        <c:ActionButton Style="{StaticResource Button.Primary}" Content="{Binding UndoText}" Command="{Binding UndoCommand}" HorizontalAlignment="Left" MinHeight="44" Padding="20,8" />
                    </DockPanel>
                </StackPanel>
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="CheckmarkCircle16" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Symbol" Value="ErrorCircle16" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Tweak}" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Message}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sv:ConflictDialogViewModel}">
        <Border Style="{StaticResource Dialog}" AutomationProperties.Name="{s:Loc conflict.title}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{s:Loc conflict.title}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Tweak}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{s:Loc conflict.body}" Margin="0,4,0,8" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Target}" />
                <TextBlock Style="{StaticResource Text.Body}"><Run Text="{s:Loc conflict.current}" /><Run Text=": " /><Run Text="{Binding Current, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,24"><Run Text="{s:Loc conflict.original}" /><Run Text=": " /><Run Text="{Binding Original, Mode=OneWay}" /></TextBlock>
                <WrapPanel HorizontalAlignment="Right">
                    <c:ActionButton Style="{StaticResource Button.Text}" Content="{s:Loc dialog.cancel}" Command="{Binding AbortCommand}" IsCancel="True" Margin="0,0,8,0" />
                    <c:ActionButton Style="{StaticResource Button.Secondary}" Content="{s:Loc conflict.keep}" Command="{Binding KeepCurrentCommand}" Margin="0,0,8,0" />
                    <c:ActionButton Style="{StaticResource Button.Primary}" Content="{s:Loc conflict.restore}" Command="{Binding RestoreOriginalCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FirstStepsViewModel}">
        <v:FirstStepsView />
    </DataTemplate>
</ResourceDictionary>
