                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{s:Loc dryrun.col.old}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="{s:Loc dryrun.col.new}" />
