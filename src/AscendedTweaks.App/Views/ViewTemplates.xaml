    <!-- Tweak-Karte: Schalter, Name, Kurzbeschreibung (2 Zeilen), Risiko- und Wirkungs-Badge, Chips, "Mehr Details". -->
    <DataTemplate DataType="{x:Type sv:TweakCardViewModel}">
        <Border Style="{StaticResource Card}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}" VerticalAlignment="Top" Margin="24,2,0,0"
                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsToggleEnabled}" ToolTip="{Binding ToggleToolTip}"
                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}" />
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Description}" Margin="0,4,0,8"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40" TextTrimming="WordEllipsis" />
                    <!-- Grund fuer einen gesperrten Schalter auch als Text, weil Tooltips deaktivierter Elemente per Tastatur nicht erreichbar sind. -->
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding ToggleToolTip, Converter={StaticResource EmptyToCollapsed}}">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info16" FontSize="16" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ToggleToolTip}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TagTexts}" Focusable="False" AutomationProperties.Name="{s:Loc card.tags}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChip}">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <c:Badge Tone="{Binding RiskTone}" Symbol="{Binding RiskSymbol}" Text="{Binding RiskText}" Filled="True" Margin="0,0,8,4" />
                        <c:Badge Tone="{Binding EvidenceTone}" Symbol="{Binding EvidenceSymbol}" Text="{Binding EvidenceText}" Margin="0,0,8,4" />
                        <c:Badge Tone="Neutral" Symbol="ArrowClockwise16" Text="{Binding RebootText}" Margin="0,0,8,4"
                                 Visibility="{Binding Tweak.RequiresReboot, Converter={StaticResource BoolToVisibility}}" />
                        <c:Badge Tone="Neutral" Symbol="Shield16" Text="{Binding AdminText}" Margin="0,0,8,4"
                                 Visibility="{Binding Tweak.RequiresAdmin, Converter={StaticResource BoolToVisibility}}" />
                        <c:Badge Tone="Accent" Symbol="History16" Text="{s:Loc card.pending}" Filled="True" Margin="0,0,8,4"
                                 Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <c:ActionButton Style="{StaticResource Button.Text}" HorizontalAlignment="Left" Margin="-16,4,0,0" Content="{s:Loc card.details}"
                                    Command="{Binding ShowDetailsCommand}" AutomationProperties.HelpText="{Binding Name}" />
                </StackPanel>
            </Grid>
        </Border>
