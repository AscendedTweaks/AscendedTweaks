<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:TweakPilot.App">
    <!-- Konverter vor den Views laden, damit Vorlagen in anderen Dictionaries sie finden. -->
    <app:LocKeyConverter x:Key="LocKey" />
    <app:GlossaryKeyConverter x:Key="GlossaryKey" />
    <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <app:BannerVisibilityConverter x:Key="BannerVisibility" />
    <app:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <app:CollapsedScrollBarConverter x:Key="CollapsedScrollBar" />
    <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <app:InverseBoolConverter x:Key="InverseBool" />
    <app:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
</ResourceDictionary>
