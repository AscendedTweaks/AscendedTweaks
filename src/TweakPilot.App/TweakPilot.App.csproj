<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TweakPilot.App</RootNamespace>
    <AssemblyName>TweakPilot.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\tweakpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TweakPilot.Core\TweakPilot.Core.csproj" />
    <ProjectReference Include="..\TweakPilot.Catalog\TweakPilot.Catalog.csproj" />
    <ProjectReference Include="..\TweakPilot.Engine\TweakPilot.Engine.csproj" />
    <ProjectReference Include="..\TweakPilot.Ipc\TweakPilot.Ipc.csproj" />
    <ProjectReference Include="..\TweakPilot.Localization\TweakPilot.Localization.csproj" />
    <!-- Der Helfer muss im selben Verzeichnis liegen (Pfadpruefung im Helfer). -->
    <ProjectReference Include="..\TweakPilot.Helper\TweakPilot.Helper.csproj" />
    <ProjectReference Include="..\TweakPilot.Appx\TweakPilot.Appx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TweakPilot.App.Tests" />
  </ItemGroup>

  <!-- V3-2: Symbol fuer Fenster und Titelleiste; die EXE nutzt ApplicationIcon. -->
  <ItemGroup>
    <Resource Include="..\..\assets\icon\tweakpilot.ico" Link="Assets\tweakpilot.ico" />
    <Resource Include="..\..\assets\icon\tweakpilot-32.png" Link="Assets\tweakpilot-32.png" />
  </ItemGroup>

  <!-- Unter "Über" geoeffnete Dokumente (Abschnitt 13). -->
  <ItemGroup>
    <Content Include="..\..\docs\SOURCES.md" Link="docs\SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\PRIVACY.md" Link="docs\PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="docs\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- V2-7: package.ps1 setzt HelperSha256; die App startet den Helfer dann nur mit genau diesem Inhalt. -->
  <ItemGroup Condition="'$(HelperSha256)' != ''">
    <AssemblyMetadata Include="HelperSha256" Value="$(HelperSha256)" />
  </ItemGroup>
</Project>
