<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>TweakPilot.Cli</RootNamespace>
    <AssemblyName>tweakpilot-cli</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\tweakpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TweakPilot.Core\TweakPilot.Core.csproj" />
    <ProjectReference Include="..\TweakPilot.Localization\TweakPilot.Localization.csproj" />
    <ProjectReference Include="..\TweakPilot.Catalog\TweakPilot.Catalog.csproj" />
    <ProjectReference Include="..\TweakPilot.Engine\TweakPilot.Engine.csproj" />
    <ProjectReference Include="..\TweakPilot.Ipc\TweakPilot.Ipc.csproj" />
    <!-- Der Helfer muss im selben Verzeichnis liegen (Pfadpruefung im Helfer). -->
    <ProjectReference Include="..\TweakPilot.Helper\TweakPilot.Helper.csproj" />
    <ProjectReference Include="..\TweakPilot.Appx\TweakPilot.Appx.csproj" />
  </ItemGroup>

  <!-- V2-7: package.ps1 setzt HelperSha256; die App startet den Helfer dann nur mit genau diesem Inhalt. -->
  <ItemGroup Condition="'$(HelperSha256)' != ''">
    <AssemblyMetadata Include="HelperSha256" Value="$(HelperSha256)" />
  </ItemGroup>
</Project>
